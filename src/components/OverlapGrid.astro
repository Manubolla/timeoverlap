---
import type { City } from '../data/cities';
import { countryName } from '../data/cities';
import { DateTime } from 'luxon';
import {
  buildHourGrid,
  getCurrentTime,
  getOffsetLabel,
  DEFAULT_WORK_HOURS,
} from '../lib/timezone';
import type { Locale } from '../i18n';

interface Props {
  city: City;
  otherCity: City;
  locale: Locale;
}

const { city, otherCity, locale } = Astro.props;
const reference = DateTime.utc();
const cells = buildHourGrid(city, otherCity, DEFAULT_WORK_HOURS, reference);
const now = getCurrentTime(city.timezone, reference).setLocale(locale);
const offsetLabel = getOffsetLabel(city.timezone, reference);
const currentHour = now.hour;
const displayName = locale === 'en' ? city.nameEn : city.name;
const displayCountry = countryName(city, locale);
---

<div class="rounded-xl border border-slate-200 bg-white p-5 dark:border-slate-800 dark:bg-slate-900/40">
  <div class="mb-4 flex items-baseline justify-between">
    <div>
      <h3 class="text-lg font-semibold text-slate-900 dark:text-slate-100">
        {displayName}
        <span class="text-sm font-normal text-slate-500 dark:text-slate-400">· {displayCountry}</span>
      </h3>
      <p class="text-xs text-slate-500"><span>{city.timezone}</span> · <span data-live-offset={city.timezone}>{offsetLabel}</span></p>
    </div>
    <div class="text-right">
      <div class="font-mono text-3xl tabular-nums text-emerald-600 dark:text-emerald-400" data-live-clock={city.timezone}>
        {now.toFormat('HH:mm')}
      </div>
      <div class="text-xs text-slate-500" data-live-date={city.timezone}>
        {now.toFormat('cccc d LLL')}
      </div>
    </div>
  </div>

  <div class="flex h-10 overflow-hidden rounded-lg border border-slate-200 dark:border-slate-800" data-live-grid={city.timezone} data-live-grid-other={otherCity.timezone}>
    {cells.map((cell) => (
      <div
        data-cell={cell.hour}
        class:list={[
          'flex-1 border-r border-slate-200 last:border-r-0 dark:border-slate-800/60',
          cell.isOverlap
            ? 'bg-emerald-500 dark:bg-emerald-400/80'
            : cell.isWorkHour
              ? 'bg-slate-200 dark:bg-slate-700/40'
              : 'bg-slate-50 dark:bg-slate-900',
          cell.hour === currentHour ? 'ring-2 ring-amber-500 dark:ring-amber-400 ring-inset' : '',
        ]}
        title={`${cell.label}:00`}
      ></div>
    ))}
  </div>

  <div class="mt-2 flex justify-between text-[10px] font-mono text-slate-500">
    <span>00</span>
    <span>06</span>
    <span>12</span>
    <span>18</span>
    <span>24</span>
  </div>
</div>
