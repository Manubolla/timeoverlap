---
import Layout from '../layouts/Layout.astro';
import { cities, countryName } from '../data/cities';
import { t, type Locale } from '../i18n';

interface Props {
  locale: Locale;
}

const { locale } = Astro.props;
const dict = t(locale);

const citiesPayload = cities.map((c) => ({
  id: c.id,
  slug: c.slug,
  slugEn: c.slugEn,
  name: locale === 'en' ? c.nameEn : c.name,
  country: countryName(c, locale),
  countryCode: c.countryCode,
  timezone: c.timezone,
  nomadHub: c.nomadHub ?? false,
  pop: c.population,
}));

// JSON-serializable only — functions get dropped via define:vars,
// so we pass templates with {placeholders} and interpolate client-side.
const i18nPayload = {
  locale,
  legendWork: dict.home.legendWork,
  legendBase: dict.home.legendBase,
  needCity: dict.home.needCity,
  savedLocal: dict.home.savedLocal,
  linkCopied: dict.home.linkCopied,
  shareTitle: dict.home.shareTitle,
  alreadyAddedTpl: locale === 'es' ? '{name} ya está en el comparador' : '{name} is already in the comparator',
  maxCitiesTpl: locale === 'es' ? 'Máximo {n} ciudades' : 'Maximum {n} cities',
  summaryOverlapTpl:
    locale === 'es'
      ? '{h}h en común entre las {n} ciudades: {range} en {city}.'
      : '{h}h in common across {n} cities: {range} in {city}.',
  summaryNoOverlapTpl:
    locale === 'es'
      ? 'No hay horario en común entre las {n} ciudades en esa franja.'
      : 'No common hours across the {n} cities in that range.',
  tooltipTpl:
    locale === 'es'
      ? 'Las {h} en {city} son las {rest}.'
      : "{h} in {city} is {rest}.",
  tooltipAndr: locale === 'es' ? ' y ' : ' and ',
};
---

<Layout
  title={dict.meta.homeTitle}
  description={dict.meta.homeDescription}
  canonicalPath={locale === 'es' ? '/' : '/en'}
>
  <section class="mx-auto max-w-7xl px-6 pt-8 pb-6 sm:pt-10">
    <div class="max-w-3xl">
      <h1 id="team-title" class="text-2xl font-bold tracking-tight sm:text-4xl">
        {dict.home.h1}
      </h1>
      <p class="mt-2 text-sm text-slate-600 dark:text-slate-400 sm:text-base">
        {dict.home.subtitle}
      </p>
    </div>
  </section>

  <section class="mx-auto max-w-7xl px-6 pb-6">
    <div class="flex flex-wrap items-end justify-center gap-3">
      <div class="relative min-w-[200px] max-w-md flex-1 rounded-xl border border-slate-200 bg-slate-50 p-3 dark:border-slate-800 dark:bg-slate-900/40">
        <label for="city-input" class="mb-1.5 block text-xs font-medium text-slate-500 dark:text-slate-400">
          {dict.home.addLabel}
        </label>
        <input
          id="city-input"
          type="text"
          placeholder={dict.home.addCity}
          class="w-full rounded-lg border border-slate-300 bg-white px-3 py-2 text-sm text-slate-900 placeholder:text-slate-400 focus:border-emerald-500 focus:outline-none dark:border-slate-700 dark:bg-slate-950 dark:text-slate-100 dark:placeholder:text-slate-500 dark:focus:border-emerald-400"
          autocomplete="off"
        />
        <ul
          id="city-suggestions"
          class="absolute left-3 right-3 z-10 mt-1 hidden max-h-56 overflow-y-auto rounded-lg border border-slate-300 bg-white dark:border-slate-700 dark:bg-slate-950"
        ></ul>
      </div>

      <div class="rounded-xl border border-slate-200 bg-slate-50 p-3 dark:border-slate-800 dark:bg-slate-900/40">
        <label class="mb-1.5 block text-xs font-medium text-slate-500 dark:text-slate-400">
          {dict.home.hoursLabel}
        </label>
        <div class="flex items-center gap-1.5">
          <select
            id="start-select"
            aria-label={dict.home.hoursStart}
            class="rounded-lg border border-slate-300 bg-white px-2 py-2 text-sm text-slate-900 focus:border-emerald-500 focus:outline-none dark:border-slate-700 dark:bg-slate-950 dark:text-slate-100 dark:focus:border-emerald-400"
          ></select>
          <span class="text-sm text-slate-500">{dict.home.hoursTo}</span>
          <select
            id="end-select"
            aria-label={dict.home.hoursEnd}
            class="rounded-lg border border-slate-300 bg-white px-2 py-2 text-sm text-slate-900 focus:border-emerald-500 focus:outline-none dark:border-slate-700 dark:bg-slate-950 dark:text-slate-100 dark:focus:border-emerald-400"
          ></select>
        </div>
      </div>
    </div>
  </section>

  <section class="mx-auto max-w-7xl px-6 pb-12">
    <div id="team-grid" class="rounded-xl border border-slate-200 bg-white dark:border-slate-800 dark:bg-slate-900/30">
      <div class="flex flex-wrap items-center justify-between gap-3 border-b border-slate-200 px-4 py-3 dark:border-slate-800">
        <span class="text-[11px] font-medium text-slate-500 dark:text-slate-400">
          {dict.home.controlsTitle}
        </span>
        <div class="flex gap-2">
          <button
            id="save-btn"
            class="rounded-lg border border-slate-300 bg-white px-3 py-1.5 text-xs font-medium text-slate-700 transition hover:border-emerald-500 hover:text-emerald-600 dark:border-slate-700 dark:bg-slate-900 dark:text-slate-200 dark:hover:border-emerald-400/40 dark:hover:text-emerald-300"
          >
            {dict.home.save}
          </button>
          <button
            id="share-btn"
            class="rounded-lg border border-slate-300 bg-white px-3 py-1.5 text-xs font-medium text-slate-700 transition hover:border-emerald-500 hover:text-emerald-600 dark:border-slate-700 dark:bg-slate-900 dark:text-slate-200 dark:hover:border-emerald-400/40 dark:hover:text-emerald-300"
          >
            {dict.home.share}
          </button>
          <button
            id="reset-btn"
            class="rounded-lg border border-rose-300 bg-rose-50 px-3 py-1.5 text-xs font-medium text-rose-600 transition hover:border-rose-400 hover:bg-rose-100 dark:border-rose-500/30 dark:bg-rose-500/10 dark:text-rose-300 dark:hover:bg-rose-500/20"
          >
            {dict.home.clear}
          </button>
        </div>
      </div>
      <div id="grid-empty" class="hidden p-12 text-center text-slate-500">
        {dict.home.empty}
      </div>
      <div id="grid-content"></div>
    </div>
    <div
      id="overlap-summary"
      class="mt-4 hidden rounded-xl border border-emerald-400/40 bg-emerald-50 p-4 text-sm text-slate-700 dark:border-emerald-400/30 dark:bg-emerald-400/5 dark:text-slate-200"
    ></div>
  </section>

  <section class="mx-auto max-w-7xl px-6 pb-20">
    <h2 class="mb-4 text-xl font-semibold text-slate-700 dark:text-slate-200">
      {dict.home.nomadHubs}
    </h2>
    <p class="mb-4 text-sm text-slate-500">{dict.home.nomadHubsHint}</p>
    <div id="nomad-hubs" class="grid grid-cols-2 gap-2 sm:grid-cols-3 lg:grid-cols-6"></div>
  </section>

  <!-- Save modal -->
  <div
    id="save-modal"
    class="fixed inset-0 z-30 hidden items-center justify-center bg-slate-950/60 p-4 backdrop-blur-sm"
  >
    <div class="w-full max-w-md rounded-xl border border-slate-200 bg-white p-6 dark:border-slate-700 dark:bg-slate-900">
      <h3 class="text-lg font-semibold text-slate-900 dark:text-slate-100">{dict.home.saveModalTitle}</h3>
      <p class="mt-1 text-sm text-slate-500 dark:text-slate-400">{dict.home.saveModalHint}</p>
      <input
        id="save-name"
        type="text"
        placeholder={dict.home.saveModalPlaceholder}
        class="mt-4 w-full rounded-lg border border-slate-300 bg-white px-3 py-2 text-sm text-slate-900 placeholder:text-slate-400 focus:border-emerald-500 focus:outline-none dark:border-slate-700 dark:bg-slate-950 dark:text-slate-100 dark:placeholder:text-slate-500 dark:focus:border-emerald-400"
      />
      <div class="mt-4 flex justify-end gap-2">
        <button
          id="save-cancel"
          class="rounded-lg px-4 py-2 text-sm text-slate-500 hover:text-slate-900 dark:text-slate-400 dark:hover:text-slate-200"
        >
          {dict.home.cancel}
        </button>
        <button
          id="save-confirm"
          class="rounded-lg bg-emerald-500 px-4 py-2 text-sm font-medium text-slate-950 hover:bg-emerald-400"
        >
          {dict.home.confirm}
        </button>
      </div>
    </div>
  </div>

  <div
    id="toast"
    class="pointer-events-none fixed bottom-6 left-1/2 z-40 -translate-x-1/2 rounded-lg bg-emerald-500 px-4 py-2 text-sm font-medium text-slate-950 opacity-0 shadow-lg transition-opacity"
  ></div>

  <div
    id="hour-tooltip"
    class="pointer-events-none fixed z-40 hidden max-w-[calc(100vw-16px)] -translate-x-1/2 -translate-y-full rounded-lg bg-slate-900 px-3 py-1.5 text-xs font-medium text-slate-100 shadow-lg ring-1 ring-slate-700 dark:bg-slate-800"
  ></div>
</Layout>

<script is:inline define:vars={{ citiesPayload, i18nPayload }}>
  window.__CITIES__ = citiesPayload;
  window.__I18N__ = i18nPayload;
</script>
<script>
  import '../scripts/team-grid';
</script>
